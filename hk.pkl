amends "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Builtins.pkl"
// Using a coding agent? See https://hk.jdx.dev/agents

local linters = new Mapping<String, Step> {
    ["cargo_fmt"] = Builtins.cargo_fmt
    ["cargo_clippy"] = Builtins.cargo_clippy
    ["markdown_lint"] = (Builtins.markdown_lint) {
        // Not yet linted/fixed; excluded so pre-existing violations there don't block unrelated commits.
        exclude = List(".claude/skills/**", ".claude/instructions/**", ".claude/RULES.md")
    }
}

local pre_push_steps = new Mapping<String, Step> {
    ["cargo_check"] = Builtins.cargo_check
    ["cargo_clippy"] = Builtins.cargo_clippy
    ["cargo_test"] {
        glob = "**/*.rs"
        check = "cargo test"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["pre-push"] {
        steps = pre_push_steps
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
