amends "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Builtins.pkl"
// Using a coding agent? See https://hk.jdx.dev/agents

local linters = new Mapping<String, Step> {
    ["cargo_fmt"] = Builtins.cargo_fmt
    ["cargo_clippy"] = Builtins.cargo_clippy
    ["markdown_lint"] = (Builtins.markdown_lint) {
        // Not yet linted/fixed; excluded so pre-existing violations there don't block unrelated commits.
        exclude = List(".claude/skills/**", ".claude/instructions/**", ".claude/RULES.md")
    }
}

local pre_push_steps = new Mapping<String, Step> {
    ["cargo_check"] = Builtins.cargo_check
    ["cargo_clippy"] = Builtins.cargo_clippy
    ["cargo_test"] {
        glob = "**/*.rs"
        check = "cargo test"
    }
    ["ctxharness"] {
        check = "ctxharness run --no-trend"
    }
}

// .context/ is untracked working state (see ways-of-working.md), so it never shows up as a
// staged file for a glob-filtered step to match. This step has no glob, so it always runs,
// keeping .context/index.yaml from drifting out of sync with plan/finding frontmatter.
local pre_commit_steps = (linters) {
    ["context_index"] {
        // .context/ never carries into a fresh worktree (untracked, see ways-of-working.md),
        // so no-op there instead of failing every commit made from one.
        fix = "test -d .context && .claude/skills/context-index/scripts/regenerate-context-index.sh || true"
    }
    ["context_filenames"] {
        // Blocking, unlike context_index above: a misplaced/misnamed .context file is a real
        // violation the context-file skill's own docs already claim this enforces, not just an
        // advisory nudge. Still skips cleanly when .context/ doesn't exist (fresh worktree).
        check = "! test -d .context || .claude/skills/context-index/scripts/check-context-filenames.sh"
    }
    ["adr_undocumented_decisions"] {
        // Blocking, same rationale as context_filenames: a .context/ decision with no ADR is
        // invisible to the ADR index the adr-capture skill maintains. Previously only skill-invoked,
        // never actually enforced here (see ADR-006's scope amendment) -- wiring it in now that the
        // 5 pre-existing undocumented decisions it found have real ADRs (adr-007..adr-010).
        check = "! test -d .context || .claude/skills/adr-capture/scripts/check-undocumented-decisions.sh"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = pre_commit_steps
    }
    ["pre-push"] {
        steps = pre_push_steps
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
