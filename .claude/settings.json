{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- aislop hook claude",
            "__aislop": {
              "v": 1,
              "managed": true,
              "hash": "sha256:76c5d8b7bfc1fd04c7b17dd5bf5c1d51"
            }
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PROJECT_DIR}/.claude/hooks/log-session-event.ts",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": ".aislop/config.yml|.aislop/rules.yml|package.json",
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- aislop hook claude --on-file-changed",
            "__aislop": {
              "v": 1,
              "managed": true,
              "hash": "sha256:a7a5e96a04eac99b2d7f53066df9dc2e"
            }
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PROJECT_DIR}/.claude/hooks/block-secret-exposure.ts",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PROJECT_DIR}/.claude/hooks/log-session-event.ts",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PROJECT_DIR}/.claude/hooks/log-session-event.ts",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PROJECT_DIR}/.claude/hooks/log-session-event.ts",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PROJECT_DIR}/.claude/hooks/log-session-event.ts",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PROJECT_DIR}/.claude/hooks/log-session-event.ts",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PROJECT_DIR}/.claude/hooks/log-session-event.ts",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PROJECT_DIR}/.claude/hooks/log-session-event.ts",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PROJECT_DIR}/.claude/hooks/surface-outstanding-work.ts",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bun ${CLAUDE_PROJECT_DIR}/.claude/hooks/surface-knowledge-base.ts",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bun ${CLAUDE_PROJECT_DIR}/.claude/hooks/log-session-event.ts",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  },
  "__agent-hooks": {
    "v": 1,
    "managed": true
  }
}
